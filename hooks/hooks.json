{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$BRAINKIT_HOOKS\" = \"1\" ] && command -v brainkit >/dev/null 2>&1 && brainkit pointer 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
